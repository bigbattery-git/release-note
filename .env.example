# Docker Compose에서 MariaDB root 계정에 적용합니다.
MARIADB_ROOT_PASSWORD=replace_with_a_local_database_password
MARIADB_DATABASE=release

# Docker Compose의 web service에서 iron-session 설정에 사용합니다.
# 32자 이상의 무작위 문자열을 사용합니다.
SESSION_PASSWORD=replace_with_at_least_32_random_characters

# 공개 Repository 조회에는 선택 사항이며, 1분 주기 실행에는 rate limit 확보를 위해 권장합니다.
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
GITHUB_TOKEN=
GITHUB_USER_AGENT=news-summery/1.0

RELEASE_COLLECTION_URL=
SCHEDULER_REQUEST_TIMEOUT_MS=