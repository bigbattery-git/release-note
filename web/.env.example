# MariaDB Info
MARIADB_ROOT_PASSWORD=your_root_password_here

# 애플리케이션에서 MariaDB에 연결할 때 사용합니다.
# Docker Compose 내부에서는 DB_HOST가 mariadb로 재정의됩니다.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_root_password_here
DB_NAME=release

# 32자 이상의 무작위 문자열을 사용합니다.
SESSION_PASSWORD=replace_with_at_least_32_random_characters

GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
GITHUB_TOKEN=
GITHUB_USER_AGENT=news-summery/1.0

OPENAI_API_SECRET_KEY=your-openai-api-secret-key-here
OPENAI_MODEL=gpt-5.6-terra
